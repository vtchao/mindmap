<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IPAS 淨零碳規劃管理師｜考點心智圖</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Space+Mono:wght@400;700&display=swap');

:root{
  --bg:#fff; --surface:#f6f8fa; --surface2:#eef1f4;
  --border:#d0d7de; --border2:#e2e7ec;
  --text:#1a1f25; --text2:#57606a; --text3:#a8b1ba;
  --accent:#0969da;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Noto Sans TC',sans-serif;background:var(--bg);color:var(--text);
  height:100vh;display:flex;flex-direction:column;overflow:hidden;}

/* Header */
header{display:flex;align-items:center;justify-content:space-between;
  padding:9px 18px;background:var(--bg);border-bottom:1px solid var(--border);flex-shrink:0;}
.logo{display:flex;align-items:center;gap:10px;}
.logo-badge{font-family:'Space Mono',monospace;font-size:11px;font-weight:700;
  background:var(--accent);color:#fff;padding:3px 8px;border-radius:5px;}
.logo-text{font-size:13px;font-weight:500;}
.logo-sub{font-size:11px;color:var(--text3);}
.hdr-actions{display:flex;gap:7px;}
.hdr-actions button{font-family:'Noto Sans TC',sans-serif;font-size:12px;padding:5px 12px;
  border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text2);cursor:pointer;}
.hdr-actions button:hover{background:var(--surface);}
.hdr-actions button.primary{background:var(--accent);border-color:var(--accent);color:#fff;}
.hdr-actions button.primary:hover{opacity:.88;}

/* Layout */
.layout{display:flex;flex:1;overflow:hidden;height:calc(100vh - 48px);}

/* Sidebar */
.sidebar{width:290px;flex-shrink:0;background:var(--surface);
  border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;}
.sb-head{padding:11px 14px 7px;font-size:10px;font-weight:700;
  text-transform:uppercase;letter-spacing:.08em;color:var(--text3);border-bottom:1px solid var(--border2);}
.sb-tip{padding:5px 13px;font-size:10px;color:var(--text3);
  border-bottom:1px solid var(--border2);background:var(--surface2);}
.sb-scroll{flex:1;overflow-y:auto;padding:8px 9px;}
.sb-scroll::-webkit-scrollbar{width:4px;}
.sb-scroll::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}

/* Tree items in sidebar */
.tree-item{margin-bottom:4px;}
.tree-row{display:flex;align-items:center;gap:5px;padding:5px 7px;
  border-radius:6px;cursor:pointer;user-select:none;transition:background .1s;}
.tree-row:hover{background:var(--surface2);}
.tree-indent{flex-shrink:0;}
.tree-toggle{width:14px;height:14px;flex-shrink:0;display:flex;align-items:center;
  justify-content:center;font-size:9px;color:var(--text3);border-radius:3px;}
.tree-toggle:hover{background:var(--border2);}
.tree-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;border:1.5px solid currentColor;}
.tree-label{flex:1;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tree-label.editable{cursor:text;}
.tree-label-input{font-family:'Noto Sans TC',sans-serif;font-size:12px;flex:1;
  border:1px solid var(--accent);border-radius:4px;padding:1px 5px;outline:none;
  background:var(--bg);color:var(--text);display:none;}
.tree-actions{display:flex;gap:2px;opacity:0;transition:opacity .1s;}
.tree-row:hover .tree-actions{opacity:1;}
.tree-btn{background:none;border:none;cursor:pointer;color:var(--text3);
  font-size:12px;padding:1px 4px;border-radius:3px;line-height:1;}
.tree-btn:hover{background:var(--border2);color:var(--text);}
.tree-btn.del:hover{color:#c0392b;}
.tree-note-row{padding:2px 7px 4px;margin-left:30px;}
.tree-note-input{font-family:'Noto Sans TC',sans-serif;font-size:11px;width:100%;
  border:none;border-bottom:1px dashed var(--border);background:transparent;
  color:var(--text2);outline:none;padding:2px 0;}
.tree-note-input::placeholder{color:var(--text3);}
.tree-children{margin-left:16px;}
.tree-add-row{display:flex;gap:4px;margin:2px 0 4px 30px;}
.tree-add-row input{flex:1;font-family:'Noto Sans TC',sans-serif;font-size:11px;
  padding:3px 7px;border:1px solid var(--border);border-radius:5px;
  background:var(--bg);color:var(--text);outline:none;}
.tree-add-row input:focus{border-color:var(--accent);}
.tree-add-row input::placeholder{color:var(--text3);}
.tree-add-row button{font-size:11px;padding:3px 8px;background:var(--surface2);
  border:1px solid var(--border);border-radius:5px;color:var(--text2);cursor:pointer;}
.tree-add-row button:hover{background:var(--surface);}

.sb-add{padding:8px 9px;border-top:1px solid var(--border2);display:flex;gap:6px;}
.sb-add input{flex:1;font-family:'Noto Sans TC',sans-serif;font-size:12px;padding:6px 9px;
  border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);outline:none;}
.sb-add input:focus{border-color:var(--accent);}
.sb-add input::placeholder{color:var(--text3);}
.sb-add button{font-family:'Noto Sans TC',sans-serif;font-size:12px;padding:6px 11px;
  background:var(--accent);border:none;border-radius:6px;color:#fff;cursor:pointer;font-weight:500;}
.sb-add button:hover{opacity:.88;}

/* Canvas */
.canvas-wrap{flex:1;overflow:hidden;position:relative;background:#fff;}
.canvas-wrap::before{content:'';position:absolute;inset:0;
  background-image:radial-gradient(circle,#cdd2d8 1px,transparent 1px);
  background-size:22px 22px;pointer-events:none;opacity:.5;}
#map-svg{width:100%;height:100%;display:block;position:relative;z-index:1;cursor:grab;}
#map-svg:active{cursor:grabbing;}

/* SVG edit overlay */
#svg-edit-overlay{position:absolute;z-index:20;display:none;}
#svg-edit-input{font-family:'Noto Sans TC',sans-serif;font-size:12px;font-weight:500;
  border:1.5px solid var(--accent);border-radius:6px;padding:3px 8px;outline:none;
  background:#fff;color:#333;box-shadow:0 2px 8px rgba(9,105,218,.15);width:100%;height:100%;}

/* Note panel (right drawer) */
#note-panel{position:absolute;right:0;top:0;bottom:0;width:280px;
  background:var(--bg);border-left:1px solid var(--border);
  display:none;flex-direction:column;z-index:15;box-shadow:-4px 0 16px rgba(0,0,0,.06);}
#note-panel.open{display:flex;}
.np-head{display:flex;align-items:center;justify-content:space-between;
  padding:12px 14px;border-bottom:1px solid var(--border2);}
.np-title{font-size:13px;font-weight:500;}
.np-close{background:none;border:none;cursor:pointer;color:var(--text3);font-size:18px;line-height:1;}
.np-close:hover{color:var(--text);}
.np-node-name{padding:8px 14px;font-size:11px;color:var(--text2);
  border-bottom:1px solid var(--border2);background:var(--surface);}
.np-body{flex:1;display:flex;flex-direction:column;padding:12px 14px;gap:8px;}
.np-label{font-size:10px;font-weight:700;text-transform:uppercase;
  letter-spacing:.07em;color:var(--text3);}
#note-textarea{flex:1;font-family:'Noto Sans TC',sans-serif;font-size:12px;
  border:1px solid var(--border);border-radius:6px;padding:8px 10px;
  resize:none;outline:none;color:var(--text);line-height:1.7;}
#note-textarea:focus{border-color:var(--accent);}
#note-textarea::placeholder{color:var(--text3);}
.np-save{font-family:'Noto Sans TC',sans-serif;font-size:12px;padding:7px;
  background:var(--accent);border:none;border-radius:6px;color:#fff;cursor:pointer;font-weight:500;}
.np-save:hover{opacity:.88;}

/* zoom / stats */
.zoom-btns{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);
  display:flex;gap:2px;z-index:5;}
.zoom-btns button{font-size:16px;width:32px;height:32px;background:var(--bg);
  border:1px solid var(--border);border-radius:6px;color:var(--text2);cursor:pointer;
  display:flex;align-items:center;justify-content:center;}
.zoom-btns button.lbl{font-size:11px;width:auto;padding:0 10px;}
.zoom-btns button:hover{background:var(--surface);}
.stats-bar{position:absolute;bottom:14px;right:16px;display:flex;gap:12px;
  background:var(--bg);border:1px solid var(--border);border-radius:16px;
  padding:5px 13px;font-size:10px;font-family:'Space Mono',monospace;color:var(--text2);z-index:5;}
.stats-bar b{color:var(--text);}
</style>
</head>
<body>

<header>
  <div class="logo">
    <span class="logo-badge">IPAS</span>
    <div>
      <div class="logo-text">淨零碳規劃管理師</div>
      <div class="logo-sub">初級考試心智圖</div>
    </div>
  </div>
  <div class="hdr-actions">
    <button onclick="exportJSON()">匯出 JSON</button>
    <button onclick="importJSON()">匯入 JSON</button>
    <button class="primary" onclick="resetView()">重置視圖</button>
  </div>
</header>

<div class="layout">
  <!-- Sidebar -->
  <div class="sidebar">
    <div class="sb-head">分支與考點</div>
    <div class="sb-tip">✏️ 雙擊名稱修改 ｜ 📝 點「備」開啟備註 ｜ ➕ 可無限新增子層</div>
    <div class="sb-scroll" id="tree-list"></div>
    <div class="sb-add">
      <input type="text" id="new-root-input" placeholder="新增主分支…"/>
      <button onclick="addRootNode()">+ 新增</button>
    </div>
  </div>

  <!-- Canvas -->
  <div class="canvas-wrap" id="canvas-wrap">
    <svg id="map-svg" xmlns="http://www.w3.org/2000/svg">
      <g id="map-root"></g>
    </svg>
    <div id="svg-edit-overlay"><input id="svg-edit-input" type="text"/></div>

    <!-- Note panel -->
    <div id="note-panel">
      <div class="np-head">
        <span class="np-title">📝 備註</span>
        <button class="np-close" onclick="closeNote()">×</button>
      </div>
      <div class="np-node-name" id="np-node-name"></div>
      <div class="np-body">
        <div class="np-label">考試筆記 / 重點說明</div>
        <textarea id="note-textarea" placeholder="在此輸入備註、解釋、記憶技巧…"></textarea>
        <button class="np-save" onclick="saveNote()">儲存備註</button>
      </div>
    </div>

    <div class="zoom-btns">
      <button onclick="zoom(0.82)">−</button>
      <button class="lbl" onclick="resetView()">重置</button>
      <button onclick="zoom(1.22)">+</button>
    </div>
    <div class="stats-bar" id="stats-bar"></div>
  </div>
</div>

<input type="file" id="import-file" accept=".json" style="display:none" onchange="handleImport(event)">

<script>
/* ─── Palette ─── */
const COLORS=['#0969da','#6639ba','#c0392b','#0a7a5f','#b45309','#9b2d6e','#2d7a3a','#0f5a7a'];
function hexBg(h,a=.07){const r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return `rgba(${r},${g},${b},${a})`;}

/* ─── Data model ───
  Node: { id, name, note, open, showAdd, children:[] }
*/
let _id=100;
function mkNode(name,children=[]){return {id:_id++,name,note:'',open:true,showAdd:false,children};}

let roots=[
  mkNode('碳排放基礎',[
    mkNode('碳中和定義'),mkNode('GHG範疇一/二/三',[mkNode('範疇一：直接排放'),mkNode('範疇二：能源間接'),mkNode('範疇三：其他間接')]),
    mkNode('淨零vs碳中和差異'),mkNode('全球暖化潛勢GWP'),mkNode('六大溫室氣體'),
  ]),
  mkNode('淨零路徑',[mkNode('再生能源'),mkNode('碳捕捉技術'),mkNode('能源效率提升'),mkNode('氫能應用'),mkNode('自然碳匯'),mkNode('電氣化策略')]),
  mkNode('碳盤查',[mkNode('ISO 14064'),mkNode('盤查邊界設定'),mkNode('ISO 14067'),mkNode('排放係數選用'),mkNode('數據品質管理'),mkNode('第三方查證')]),
  mkNode('碳交易與碳市場',[mkNode('碳權定義'),mkNode('自願性碳市場VCM'),mkNode('強制性碳市場ETS'),mkNode('碳抵換機制')]),
  mkNode('法規與國際協議',[mkNode('巴黎協定'),mkNode('IPCC報告'),mkNode('台灣氣候變遷因應法'),mkNode('2050淨零排放路徑')]),
  mkNode('企業減碳策略',[mkNode('SBTi科學基礎減量'),mkNode('ESG揭露要求'),mkNode('RE100倡議'),mkNode('供應鏈減碳')]),
  mkNode('碳足跡與LCA',[mkNode('LCA概念'),mkNode('產品碳足跡計算'),mkNode('Scope3排放熱點'),mkNode('ISO 14067')]),
  mkNode('碳中和宣告',[mkNode('PAS 2060標準'),mkNode('碳抵換選購原則'),mkNode('避免漂綠')]),
];

/* ─── Find node by id ─── */
function findNode(id,nodes=roots,parent=null,idx=0){
  for(let i=0;i<nodes.length;i++){
    if(nodes[i].id===id) return {node:nodes[i],siblings:nodes,idx:i,parent};
    const f=findNode(id,nodes[i].children,nodes[i],i);
    if(f) return f;
  }
  return null;
}

/* ─── Pan / Zoom ─── */
const svg=document.getElementById('map-svg');
let vx=-80,vy=-40,vw=1100,vh=740;
let panning=false,panStart=null,editState=null;
function applyVB(){svg.setAttribute('viewBox',`${vx} ${vy} ${vw} ${vh}`);}
svg.addEventListener('mousedown',e=>{
  if(e.button!==0||e.target.closest('[data-btn]')||editState) return;
  panning=true; panStart={x:e.clientX,y:e.clientY,vx,vy}; e.preventDefault();
});
window.addEventListener('mousemove',e=>{
  if(!panning) return;
  const rect=svg.getBoundingClientRect();
  vx=panStart.vx-(e.clientX-panStart.x)*vw/rect.width;
  vy=panStart.vy-(e.clientY-panStart.y)*vh/rect.height;
  applyVB();
});
window.addEventListener('mouseup',()=>{panning=false;});
svg.addEventListener('wheel',e=>{
  e.preventDefault(); if(editState) return;
  const rect=svg.getBoundingClientRect();
  const mx=(e.clientX-rect.left)/rect.width*vw+vx;
  const my=(e.clientY-rect.top)/rect.height*vh+vy;
  const f=e.deltaY>0?1.1:.91;
  vw*=f;vh*=f;vx=mx-(mx-vx)*f;vy=my-(my-vy)*f;applyVB();
},{passive:false});
function zoom(f){const cx=vx+vw/2,cy=vy+vh/2;vw*=f;vh*=f;vx=cx-vw/2;vy=cy-vh/2;applyVB();}
function resetView(){vx=-80;vy=-40;vw=1100;vh=740;applyVB();}

/* ─── SVG Layout constants ─── */
const NODE_H=32, NODE_GAP_Y=10;
const COL_W=140, COL_GAP=48;
const ROOT_W=96, ROOT_H=42;
const FONT=11;

/* measure subtree height */
function subtreeH(node){
  if(!node.children.length) return NODE_H;
  const childrenH=node.children.reduce((s,c,i)=>s+subtreeH(c)+(i?NODE_GAP_Y:0),0);
  return Math.max(NODE_H,childrenH);
}

/* ─── SVG Render ─── */
function renderSVG(){
  const root=document.getElementById('map-root');

  const totalH=roots.reduce((s,r,i)=>s+subtreeH(r)+(i?NODE_GAP_Y*2:0),0);
  const rootY=(totalH-ROOT_H)/2;
  const rootX=0;

  let paths='',nodes='';

  /* root box */
  nodes+=`<rect x="${rootX}" y="${rootY}" width="${ROOT_W}" height="${ROOT_H}" rx="9" fill="#0969da"/>`;
  nodes+=`<text x="${rootX+ROOT_W/2}" y="${rootY+ROOT_H/2}" text-anchor="middle" dominant-baseline="central"
    font-family="'Space Mono',monospace" font-size="12" font-weight="700" fill="#fff">IPAS</text>`;

  /* draw tree columns */
  let curY=0;
  roots.forEach((r,ri)=>{
    const col=COLORS[ri%COLORS.length];
    const sh=subtreeH(r);
    const rMidY=curY+sh/2;

    /* connector root→col1 */
    const rx1=rootX+ROOT_W, ry1=rootY+ROOT_H/2;
    const bx=rootX+ROOT_W+COL_GAP, bw=COL_W, bh=NODE_H;
    const by=rMidY-bh/2;
    const cp=(rx1+bx)/2;
    paths+=`<path d="M${rx1},${ry1} C${cp},${ry1} ${cp},${rMidY} ${bx},${rMidY}"
      fill="none" stroke="${col}" stroke-width="1.6" opacity=".45"/>`;

    /* level-1 node */
    const hasNote=r.note&&r.note.trim();
    nodes+=svgNode(r,col,bx,by,bw,bh,1);
    if(hasNote) nodes+=noteIndicator(bx+bw-10,by+4,col);

    /* recurse children */
    const {p,n}=drawChildren(r.children,bx+bw,rMidY,curY,col,2);
    paths+=p; nodes+=n;

    curY+=sh+NODE_GAP_Y*2;
  });

  root.innerHTML=paths+nodes;
  updateStats();
}

function drawChildren(children,parentRx,parentMidY,offsetY,col,depth){
  if(!children||!children.length) return {p:'',n:''};
  let paths='',nodes='';
  const cx=parentRx+COL_GAP;
  const cw=Math.max(COL_W-depth*8,90);
  const ch=NODE_H;

  const totalCH=children.reduce((s,c,i)=>s+subtreeH(c)+(i?NODE_GAP_Y:0),0);
  let childY=parentMidY-totalCH/2;

  // clamp so children don't go negative
  if(childY<offsetY) childY=offsetY;

  children.forEach((child)=>{
    const sh=subtreeH(child);
    const cMidY=childY+sh/2;
    const cy=cMidY-ch/2;
    const cp=(parentRx+cx)/2;

    paths+=`<path d="M${parentRx},${parentMidY} C${cp},${parentMidY} ${cp},${cMidY} ${cx},${cMidY}"
      fill="none" stroke="${col}" stroke-width="${Math.max(.7,1.4-depth*.2)}" opacity="${Math.max(.2,.4-depth*.06)}" stroke-dasharray="${depth>1?'4 3':''}"/>`;

    const hasNote=child.note&&child.note.trim();
    nodes+=svgNode(child,col,cx,cy,cw,ch,depth);
    if(hasNote) nodes+=noteIndicator(cx+cw-9,cy+3,col);

    const {p,n}=drawChildren(child.children,cx+cw,cMidY,childY,col,depth+1);
    paths+=p; nodes+=n;

    childY+=sh+NODE_GAP_Y;
  });
  return {p:paths,n:nodes};
}

function svgNode(node,col,x,y,w,h,depth){
  const isL1=depth===1;
  const rx_val=isL1?8:14;
  const fw=isL1?'500':'400';
  const fs=isL1?12:FONT;
  const txt=node.name.length>14?node.name.slice(0,13)+'…':node.name;
  const bg=isL1?hexBg(col,.08):'#fff';
  const stroke=col;
  const sw=isL1?1.2:.8;
  const tc=isL1?col:'#444';
  const esc_name=node.name.replace(/'/g,"\\'").replace(/"/g,'&quot;');
  return `<g data-btn="1" style="cursor:pointer"
    ondblclick="startSVGEdit(event,${node.id},${x},${y},${w},${h},'${esc_name}')">
    <rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${rx_val}"
      fill="${bg}" stroke="${stroke}" stroke-width="${sw}"/>
    <text x="${x+w/2}" y="${y+h/2}" text-anchor="middle" dominant-baseline="central"
      font-family="'Noto Sans TC',sans-serif" font-size="${fs}" font-weight="${fw}" fill="${tc}">
      <title>${node.name}</title>${txt}</text>
  </g>`;
}

function noteIndicator(x,y,col){
  return `<circle cx="${x}" cy="${y}" r="4" fill="${col}" opacity=".7"/>`;
}

/* ─── SVG Inline Edit ─── */
const overlay=document.getElementById('svg-edit-overlay');
const editInput=document.getElementById('svg-edit-input');

function startSVGEdit(e,nodeId,rx,ry,rw,rh,currentVal){
  e.stopPropagation();
  commitSVGEdit();
  const wrap=document.getElementById('canvas-wrap');
  const svgRect=svg.getBoundingClientRect();
  const wrapRect=wrap.getBoundingClientRect();
  const sx=svgRect.width/vw, sy=svgRect.height/vh;
  const screenX=(rx-vx)*sx+svgRect.left-wrapRect.left;
  const screenY=(ry-vy)*sy+svgRect.top-wrapRect.top;
  editState={nodeId};
  overlay.style.cssText=`display:block;left:${screenX}px;top:${screenY}px;width:${rw*sx}px;height:${rh*sy}px;`;
  editInput.style.fontSize=Math.max(11,12*sx)+'px';
  editInput.value=currentVal;
  editInput.focus(); editInput.select();
}
function commitSVGEdit(){
  if(!editState) return;
  const val=editInput.value.trim();
  if(val){const f=findNode(editState.nodeId); if(f) f.node.name=val;}
  overlay.style.display='none'; editState=null; render();
}
editInput.addEventListener('keydown',e=>{
  if(e.key==='Enter'){e.preventDefault();commitSVGEdit();}
  if(e.key==='Escape'){overlay.style.display='none';editState=null;renderSVG();}
});
document.getElementById('canvas-wrap').addEventListener('mousedown',e=>{
  if(editState&&!overlay.contains(e.target)) commitSVGEdit();
});

/* ─── Note Panel ─── */
let noteNodeId=null;
function openNote(id){
  const f=findNode(id); if(!f) return;
  noteNodeId=id;
  document.getElementById('np-node-name').textContent='節點：'+f.node.name;
  document.getElementById('note-textarea').value=f.node.note||'';
  document.getElementById('note-panel').classList.add('open');
  document.getElementById('note-textarea').focus();
}
function closeNote(){document.getElementById('note-panel').classList.remove('open');noteNodeId=null;}
function saveNote(){
  if(noteNodeId===null) return;
  const f=findNode(noteNodeId); if(!f) return;
  f.node.note=document.getElementById('note-textarea').value;
  closeNote(); render();
}

/* ─── Sidebar Tree ─── */
function renderSidebar(){
  const el=document.getElementById('tree-list');
  el.innerHTML=roots.length
    ? roots.map((r,ri)=>renderTreeItem(r,0,COLORS[ri%COLORS.length],ri)).join('')
    : '<div style="padding:12px 4px;font-size:12px;color:var(--text3)">尚無分支，請在下方新增</div>';
}

function renderTreeItem(node,depth,col,rootIdx){
  const hasChildren=node.children.length>0;
  const indent=depth*16;
  const isRoot=depth===0;
  const dotStyle=isRoot?`background:${col};border-color:${col};border-radius:3px;`:`border-color:${col};`;
  const labelColor=isRoot?col:'var(--text)';
  const noteIcon=node.note&&node.note.trim()?'📝':'📋';

  let html=`<div class="tree-item" id="ti-${node.id}">
    <div class="tree-row" onclick="toggleNodeOpen(${node.id})">
      <div class="tree-indent" style="width:${indent}px"></div>
      <div class="tree-toggle">${hasChildren?(node.open?'▾':'▸'):' '}</div>
      <div class="tree-dot" style="${dotStyle}"></div>
      <div class="bc-name-wrap" style="flex:1;min-width:0;">
        <span class="tree-label" style="color:${labelColor};font-weight:${isRoot?500:400}"
          ondblclick="startSBRename(${node.id},event)">${node.name}</span>
        <input class="tree-label-input" id="sbi-${node.id}"
          onblur="commitSBRename(${node.id},this)"
          onkeydown="if(event.key==='Enter')this.blur();if(event.key==='Escape')cancelSBRename(${node.id})"/>
      </div>
      <div class="tree-actions">
        <button class="tree-btn" data-btn title="備註" onclick="event.stopPropagation();openNote(${node.id})">${noteIcon}</button>
        <button class="tree-btn" data-btn title="新增子節點" onclick="event.stopPropagation();toggleAddChild(${node.id})">＋</button>
        <button class="tree-btn del" data-btn title="刪除" onclick="event.stopPropagation();deleteNode(${node.id})">×</button>
      </div>
    </div>`;

  /* inline add child row */
  if(node.showAdd){
    html+=`<div class="tree-add-row">
      <input type="text" id="add-${node.id}" placeholder="新增子節點名稱…"
        onkeydown="if(event.key==='Enter')addChild(${node.id});if(event.key==='Escape')cancelAddChild(${node.id})"/>
      <button data-btn onclick="addChild(${node.id})">確定</button>
    </div>`;
  }

  /* children */
  if(hasChildren&&node.open){
    const childRootIdx=depth===0?roots.indexOf(node):roots.findIndex(r=>containsNode(r,node.id));
    const childCol=COLORS[childRootIdx<0?0:childRootIdx%COLORS.length];
    html+=`<div class="tree-children">${node.children.map(c=>renderTreeItem(c,depth+1,childCol,childRootIdx)).join('')}</div>`;
  }

  html+=`</div>`;
  return html;
}

function containsNode(root,id){
  if(root.id===id) return true;
  return root.children.some(c=>containsNode(c,id));
}

/* sidebar rename */
function startSBRename(id,e){
  e.stopPropagation();
  const f=findNode(id); if(!f) return;
  const span=document.querySelector(`#ti-${id} .tree-label`);
  const inp=document.getElementById(`sbi-${id}`);
  inp.value=f.node.name; span.style.display='none'; inp.style.display='block';
  inp.focus(); inp.select();
}
function commitSBRename(id,inp){
  const val=inp.value.trim(); const f=findNode(id);
  if(f&&val) f.node.name=val; render();
}
function cancelSBRename(id){
  const span=document.querySelector(`#ti-${id} .tree-label`);
  const inp=document.getElementById(`sbi-${id}`);
  if(span) span.style.display='';  if(inp) inp.style.display='none';
}

/* toggle open */
function toggleNodeOpen(id){
  const f=findNode(id); if(!f) return;
  f.node.open=!f.node.open; renderSidebar();
}

/* add child */
function toggleAddChild(id){
  const f=findNode(id); if(!f) return;
  f.node.showAdd=!f.node.showAdd;
  renderSidebar();
  if(f.node.showAdd) setTimeout(()=>{ const el=document.getElementById(`add-${id}`); if(el){el.focus();} },50);
}
function addChild(id){
  const inp=document.getElementById(`add-${id}`); if(!inp) return;
  const name=inp.value.trim(); if(!name) return;
  const f=findNode(id); if(!f) return;
  f.node.children.push(mkNode(name));
  f.node.open=true; f.node.showAdd=false;
  render();
}
function cancelAddChild(id){
  const f=findNode(id); if(!f) return;
  f.node.showAdd=false; renderSidebar();
}

/* delete node */
function deleteNode(id){
  const f=findNode(id); if(!f) return;
  const label=f.node.name;
  if(!confirm(`確定刪除「${label}」及其所有子節點？`)) return;
  f.siblings.splice(f.idx,1); render();
}

/* add root */
function addRootNode(){
  const inp=document.getElementById('new-root-input');
  const name=inp.value.trim(); if(!name) return;
  roots.push(mkNode(name)); inp.value=''; render();
}

function updateStats(){
  let total=0;
  function countAll(nodes){nodes.forEach(n=>{total++;countAll(n.children);});}
  countAll(roots);
  const depth=maxDepth(roots);
  document.getElementById('stats-bar').innerHTML=
    `<span>分支 <b>${roots.length}</b></span><span>節點 <b>${total}</b></span><span>最深 <b>${depth}</b> 層</span>`;
}
function maxDepth(nodes,d=0){
  if(!nodes.length) return d;
  return Math.max(...nodes.map(n=>maxDepth(n.children,d+1)));
}

function render(){renderSidebar();renderSVG();}

/* ─── JSON ─── */
function exportJSON(){
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([JSON.stringify(roots,null,2)],{type:'application/json'}));
  a.download='ipas-mindmap.json'; a.click();
}
function importJSON(){document.getElementById('import-file').click();}
function handleImport(e){
  const file=e.target.files[0]; if(!file) return;
  const r=new FileReader();
  r.onload=ev=>{
    try{roots=JSON.parse(ev.target.result);render();}
    catch{alert('JSON 格式錯誤');}
  };
  r.readAsText(file); e.target.value='';
}

document.getElementById('new-root-input').addEventListener('keydown',e=>{if(e.key==='Enter')addRootNode();});

applyVB(); render();
</script>
